rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().data.approved == true;
    }

    function role() {
      return currentUser().data.role;
    }

    function isAdmin() {
      return isApproved() && role() in ['SuperAdmin', 'Admin', 'Executive'];
    }

    function isManager() {
      return isApproved() && role() == 'Manager';
    }

    function isSales() {
      return isApproved() && role() == 'Sales';
    }

    function isAccounting() {
      return isApproved() && role() == 'Accounting';
    }

    function isWorkerRole() {
      return isApproved() && role() in [
        'Designer',
        'Cabinet Maker',
        'Installer',
        'Installer Helper',
        'Subcontractor',
        'Countertop Subcontractor',
        'Worker'
      ];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /catalogProducts/{productId} {
      allow read: if isApproved();
      allow write: if isAdmin() || isManager();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin() || isManager() || isSales();
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin() || isManager() || isSales();
    }

    match /quotes/{quoteId} {
      allow read, write: if isAdmin() || isManager() || isSales();
    }

    match /teamMembers/{memberId} {
      allow read: if isAdmin() || isManager() || isAccounting();
      allow create, update, delete: if isAdmin() || isManager();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isManager() || isSales() || isAccounting() || isWorkerRole();
      allow write: if isAdmin() || isManager();
    }

    match /productionTasks/{taskId} {
      allow read: if isAdmin() || isManager() || isWorkerRole();
      allow write: if isAdmin() || isManager() || isWorkerRole();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
